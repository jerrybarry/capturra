<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Show Dock icon and allow app switcher entry -->
  <key>LSUIElement</key>
  <false/>
  <!-- shown by macOS when Capturra first asks to record the microphone -->
